# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fabhouse

# NextAuth
NEXTAUTH_SECRET=replace-with-a-random-string
NEXTAUTH_URL=http://localhost:3000

# Google OAuth — create credentials at console.cloud.google.com
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Billing — leave false until you're ready to charge.
# See config/features.ts for what flipping this does.
NEXT_PUBLIC_BILLING_ENABLED=false

# Paystack (only needed once NEXT_PUBLIC_BILLING_ENABLED=true)
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Cloudinary (image uploads) — free account at cloudinary.com
# See components/ImageUploader.tsx for the 5-minute setup.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
# Server-side only (from Cloudinary dashboard) — needed so deleting a
# listing also deletes its photos. Without these, deletion still works,
# it just leaves the images in Cloudinary storage.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend (email notifications) — free account at resend.com
# Without this set, emails are logged to the console instead of sent.
RESEND_API_KEY=
EMAIL_FROM=Fabhouse <onboarding@resend.dev>

# Vercel Cron — generate a long random value and set it in Vercel project env vars.
# Scheduled listing reminders run daily at 08:00 UTC; keep this value private.
CRON_SECRET=replace-with-a-random-string
